+// LOCAL PATCH (ik-llama-toolkit), RESULTS 47: dump-on-abort helpers.
+// 46.4 proved the NaN is computed DETERMINISTICALLY by fattn-0 from clean
+// inputs, so a byte dump of the layer-0 KV plus the token history is a
+// complete offline reproducer (layer 0's Q depends only on the ubatch tokens).
+extern "C" void llama_ik_kv_info(struct llama_context * ctx, int * head, int * used, int * n_total) {
+    if (head)    *head    = (int) ctx->kv_self.head;
+    if (used)    *used    = (int) ctx->kv_self.used;
+    if (n_total) *n_total = (int) ctx->kv_self.size;
+}
+
+// inverse of the dump: overwrite one layer's KV bytes with a dumped file.
+// RESULTS 47.1: replay-from-tokens cannot be bit-exact because the server's
+// history was chunked by many requests, and the trigger is a bit pattern. The
+// dumped bytes ARE the server's bits; injecting them after a body prefill (which
+// only exists to populate the cells) makes layer 0/1 identical to the abort.
+extern "C" int llama_ik_load_kv_layer(struct llama_context * ctx, int il, const char * path) {
+    if (il < 0 || il >= (int) ctx->kv_self.k_l.size()) return -1;
+    ggml_tensor * t = ctx->kv_self.k_l[il];
+    if (!t) return -2;
+    FILE * f = fopen(path, "rb");
+    if (!f) return -3;
+    int32_t hdr[6];
+    if (fread(hdr, sizeof(hdr), 1, f) != 1) { fclose(f); return -4; }
+    const size_t nbytes = ggml_nbytes(t);
+    std::vector<uint8_t> buf(nbytes);
+    const size_t got = fread(buf.data(), 1, nbytes, f);
+    fclose(f);
+    if (got != nbytes) return -5;
+    ggml_backend_tensor_set(t, buf.data(), 0, nbytes);
+    return (int) (nbytes / (1024*1024));
+}
+
+extern "C" int llama_ik_dump_kv_layer(struct llama_context * ctx, int il, const char * path) {
+    if (il < 0 || il >= (int) ctx->kv_self.k_l.size()) return -1;
+    ggml_tensor * t = ctx->kv_self.k_l[il];
+    if (!t) return -2;
+    const size_t nbytes = ggml_nbytes(t);
+    std::vector<uint8_t> buf(nbytes);
+    ggml_backend_tensor_get(t, buf.data(), 0, nbytes);
+    FILE * f = fopen(path, "wb");
+    if (!f) return -3;
+    // small self-describing header: type, ne[4], nbytes
+    int32_t hdr[6] = { (int32_t) t->type,
+                       (int32_t) t->ne[0], (int32_t) t->ne[1],
+                       (int32_t) t->ne[2], (int32_t) t->ne[3],
+                       (int32_t) 0 };
+    fwrite(hdr, sizeof(hdr), 1, f);
+    fwrite(buf.data(), 1, nbytes, f);
+    fclose(f);
+    return (int) (nbytes / (1024*1024));
+}
