+                }
+
+                // Greppable, because the point of surviving is being able to tell
+                // afterwards that it happened and that recovery was clean:
+                //   grep 'NaN logits' logs/server-*.log
+                // The next request for this slot will show cache_size = 0 and a
+                // prefill from p0=0, which is the confirmation that it recovered.
+                LOG_ERROR("NaN logits -- dropped this slot's cached state, the next request will prefill from scratch", {
+                    {"id_slot",             slot.id},
+                    {"id_task",             slot.id_task},
+                    {"cache_tokens_erased", (uint64_t) n_tok_erased},
+                    {"checkpoints_erased",  (uint64_t) n_ckpt_erased},
+                });
+
                 slot.release();
                 slot.i_batch = -1;
                 continue;
diff --git a/examples/server/server-task.cpp b/examples/server/server-task.cpp
index 95c1a05f..35c80f45 100644
--- a/examples/server/server-task.cpp
+++ b/examples/server/server-task.cpp
@@ -1213,6 +1213,25 @@ void server_prompt_cache::update() {
 
             states.pop_front();
         }
+
+        // The loop above cannot help when a *single* state is over the limit,
+        // and one easily is: a state carries up to --ctx-checkpoints
+        // checkpoints, and a checkpoint is a fixed size regardless of how many
+        // tokens it covers (~872 MiB at 131072 ctx here, ~1/6 of the whole KV
+        // cache), so 32 of them is ~27 GiB against a default limit of 8 GiB.
+        // Observed: 1 prompt holding 18 checkpoints = 18803 MiB, limit 8192.
+        //
+        // Checkpoints are an optimisation for partial reuse, not the state
+        // itself -- `data` is. So trim them oldest-first to get back under the
+        // limit, rather than letting the cache silently ignore it.
+        for (auto& state : states) {
+            while (size() > limit_size && !state.checkpoints.empty()) {
+                LLAMA_LOG_INFO(" - cache size limit reached, dropping a checkpoint (size = %.3f MiB)\n",
+                    state.checkpoints.front().size() / (1024.0 * 1024.0));
+
+                state.checkpoints.pop_front();
+            }
+        }
     }
 
     // average size per token
diff --git a/ggml/src/ggml-alloc.c b/ggml/src/ggml-alloc.c
index 70433f98..3bc12a18 100644
--- a/ggml/src/ggml-alloc.c
+++ b/ggml/src/ggml-alloc.c
@@ -868,6 +868,61 @@ static bool ggml_gallocr_needs_realloc(ggml_gallocr_t galloc, struct ggml_cgraph
     return false;
 }
 
+
+// IK_OVERLAP: does the allocator hand the same device memory to two tensors that
+// are both live? RESULTS 41 suspects exactly that for the split-input copies --
+// `ggml_set_input`/`ggml_set_output` is what stops it, and that guard is behind
+// `n_copies > 1`, which is never true here. Rather than wait ~8 M tokens to see
+// whether aborts stop, this looks at the allocation directly: it walks every
+// tensor in the graph and reports any pair whose byte ranges intersect, naming
+// them. Off unless IK_OVERLAP=1; one report per distinct pair of names.
+static void ik_overlap_check(struct ggml_cgraph * graph) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_OVERLAP"); on = (e && atoi(e)) ? 1 : 0; }
+    if (on != 1 || !graph) return;
+
+    // Collect every tensor that has storage, nodes and leafs alike.
+    enum { MAXT = 8192 };
+    static const struct ggml_tensor * ts[MAXT];
+    int n = 0;
+    for (int i = 0; i < graph->n_leafs && n < MAXT; i++) {
+        const struct ggml_tensor * t = graph->leafs[i];
+        if (t && t->data && !t->view_src) ts[n++] = t;
+    }
+    for (int i = 0; i < graph->n_nodes && n < MAXT; i++) {
+        const struct ggml_tensor * t = graph->nodes[i];
+        if (t && t->data && !t->view_src) ts[n++] = t;
+    }
+
+    static long long calls = 0;
+    ++calls;
+    int found = 0;
+    for (int i = 0; i < n; i++) {
+        const char * a = ts[i]->data;
+        const char * ae = a + ggml_nbytes(ts[i]);
+        for (int j = i + 1; j < n; j++) {
+            if (ts[i]->buffer != ts[j]->buffer) continue;
+            const char * b = ts[j]->data;
+            const char * be = b + ggml_nbytes(ts[j]);
+            if (a < be && b < ae) {
+                // Only interesting when one of them is a split-input copy.
+                if (strstr(ts[i]->name, "raw_k-") || strstr(ts[j]->name, "raw_k-")) {
+                    fprintf(stderr, "IK_OVERLAP: %s [%p,%p) overlaps %s [%p,%p)\n",
+                            ts[i]->name, (const void *)a, (const void *)ae,
+                            ts[j]->name, (const void *)b, (const void *)be);
+                    fflush(stderr);
+                    ++found;
+                }
+            }
+        }
+    }
+    if (calls == 1 || calls % 200 == 0) {
+        fprintf(stderr, "IK_OVERLAP: alive, graph #%lld, %d tensors with storage, %d raw_k overlaps this graph\n",
+                calls, n, found);
+        fflush(stderr);
+    }
+}
+
 bool ggml_gallocr_alloc_graph(ggml_gallocr_t galloc, struct ggml_cgraph * graph) {
     if (ggml_gallocr_needs_realloc(galloc, graph)) {
         if (galloc->n_buffers == 1) {
@@ -913,6 +968,8 @@ bool ggml_gallocr_alloc_graph(ggml_gallocr_t galloc, struct ggml_cgraph * graph)
         ggml_gallocr_init_tensor(galloc, node, &node_alloc->dst);
     }
 
+    ik_overlap_check(graph);
+
     return true;
 }
 
diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index a6a394c4..6b1c0e14 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -208,7 +208,215 @@ size_t ggml_backend_get_max_size(ggml_backend_t backend) {
     return ggml_backend_buft_get_max_size(ggml_backend_get_default_buffer_type(backend));
 }
 
+// IK_COPY_CHECK -- placed on the two low-level entry points every copy funnels
+// through, after three attempts at guessing the right branch in the scheduler
+// each landed somewhere raw_k never goes. The heartbeat is what caught that: a
+// counter of 1 over 35 000 prefilled tokens meant "this path is not used", not
+// "the data is clean". RESULTS 36.9 and 38.6.
+// IK_DST_CHECK: read the DESTINATION back immediately after the copy and compare
+// it with the source. RESULTS 40.5: CUDA0#raw_k-0 is NaN on the device while the
+// host bytes it came from are clean, and that is the one step in the chain with
+// no measurement behind it. Only for the tensors that matter, because a device
+// readback per copy would be ruinous.
+static bool ik_dst_check_wanted(const struct ggml_tensor * src, const struct ggml_tensor * dst) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_DST_CHECK"); on = (e && atoi(e)) ? 1 : 0; }
+    if (on != 1 || !src || !dst) return false;
+    if (src->type != GGML_TYPE_F16) return false;
+    // layers 0 and 1 only -- the uncompressed ones, where the poison starts
+    return strncmp(src->name, "raw_k-0", 7) == 0 || strncmp(src->name, "raw_k-1", 7) == 0;
+}
+
+static void ik_dst_check_after(const struct ggml_tensor * src, const struct ggml_tensor * dst) {
+    const size_t nb = ggml_nbytes(src);
+    const size_t n16 = nb / 2;
+    std::vector<uint16_t> buf(n16);
+    ggml_backend_tensor_get(dst, buf.data(), 0, nb);
+
+    const uint16_t * h = (const uint16_t *) src->data;
+    size_t src_nan = 0, dst_nan = 0, first_dst = 0, diff = 0;
+    for (size_t i = 0; i < n16; ++i) {
+        const bool sn = (h[i]      & 0x7FFFu) > 0x7C00u;
+        const bool dn = (buf[i]    & 0x7FFFu) > 0x7C00u;
+        if (sn) ++src_nan;
+        if (dn) { if (dst_nan == 0) first_dst = i; ++dst_nan; }
+        if (h[i] != buf[i]) ++diff;
+    }
+    static long long calls = 0;
+    ++calls;
+    if (dst_nan || diff) {
+        fprintf(stderr, "IK_DST_CHECK: %s -> %s: src_nan=%zu dst_nan=%zu (first %zu) differing=%zu of %zu\n",
+                src->name, dst->name, src_nan, dst_nan, first_dst, diff, n16);
+        fflush(stderr);
+    }
+    if (calls == 1 || calls % 100 == 0) {
+        fprintf(stderr, "IK_DST_CHECK: alive, %lld destination reads compared\n", calls);
+        fflush(stderr);
+    }
+}
+
+// IK_RAWK_GUARD=0 restores upstream behaviour (guard only when n_copies > 1),
+// so one build can test both. Default on.
+// ===== IK_LIFETIME: prove (or disprove) that raw_k's storage is overwritten
+// while it is still needed. RESULTS 41.4: the overlap check shows raw_k shares
+// storage with other tensors, but sharing is what the allocator is FOR -- only a
+// lifetime conflict is a bug. So: checksum the destination right after the copy,
+// and check it again at the moment attention consumes it. A difference is the
+// proof; equality kills the hypothesis.
+//
+// Requires GGML_CUDA_DISABLE_GRAPHS=1: reading device memory synchronises, which
+// is illegal during graph capture.
+#include <unordered_map>
+#include <unordered_set>
+struct ik_rawk_rec { uint64_t sum; size_t nbytes; size_t nan_at_copy; char name[GGML_MAX_NAME]; };
+static std::unordered_set<const void *> g_ik_copied;
+static std::unordered_map<const void *, ik_rawk_rec> g_ik_rawk;
+
+static uint64_t ik_sum16(const uint16_t * p, size_t n) {
+    uint64_t h = 1469598103934665603ULL;
+    for (size_t i = 0; i < n; ++i) { h ^= p[i]; h *= 1099511628211ULL; }
+    return h;
+}
+
+extern "C" bool ik_sum_check_enabled(void);
+extern "C" void ik_sum_clear(void);
+extern "C" void ik_sum_mark_tensor(ggml_backend_t backend, const struct ggml_tensor * t);
+
+extern "C" bool ik_lifetime_on(void) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_LIFETIME"); on = (e && atoi(e)) ? 1 : 0; }
+    return on == 1;
+}
+
+// called right after a host->device copy of a raw_k tensor
+static void ik_lifetime_record(const struct ggml_tensor * src, struct ggml_tensor * dst) {
+    if (!ik_lifetime_on() || !dst || !dst->data) return;
+    if (!src || !src->name[0] || strncmp(src->name, "raw_k-", 6) != 0) return;
+    const size_t nb = ggml_nbytes(dst);
+    std::vector<uint16_t> tmp(nb/2);
+    ggml_backend_tensor_get(dst, tmp.data(), 0, nb);
+    ik_rawk_rec rec; rec.sum = ik_sum16(tmp.data(), tmp.size()); rec.nbytes = nb;
+    snprintf(rec.name, sizeof(rec.name), "%s", dst->name);
+    // Count NaN already present in what we just copied in. If the copy is skipped
+    // for a graph, the checksum would be taken from stale device content and the
+    // verify below would report no change even though the buffer is poisoned --
+    // the one blind spot this probe would otherwise have.
+    size_t nan_at_copy = 0;
+    for (size_t q = 0; q < tmp.size(); ++q) if ((tmp[q] & 0x7FFFu) > 0x7C00u) ++nan_at_copy;
+    rec.nan_at_copy = nan_at_copy;
+    if (nan_at_copy) {
+        fprintf(stderr, "IK_LIFETIME: %s was ALREADY NaN right after the copy -- %zu of %zu f16\n",
+                dst->name, nan_at_copy, tmp.size());
+        fflush(stderr);
+    }
+    g_ik_rawk[dst->data] = rec;
+    g_ik_copied.insert(dst->data);
+}
+
+// called from ggml-cuda.cu when a node is about to consume a tensor
+extern "C" void ik_lifetime_verify(const struct ggml_tensor * t, const char * consumer) {
+    if (!ik_lifetime_on() || !t || !t->data) return;
+    auto it = g_ik_rawk.find(t->data);
+    if (it == g_ik_rawk.end()) {
+        // A raw_k copy consumed in a graph where no copy was recorded: the device
+        // buffer holds whatever was there before. Report it once per name.
+        if (t->name[0] && strstr(t->name, "raw_k-") && !g_ik_copied.count(t->data)) {
+            static std::unordered_set<std::string> told;
+            if (told.insert(t->name).second) {
+                fprintf(stderr, "IK_LIFETIME: %s consumed by %s but NOT copied in this graph\n",
+                        t->name, consumer ? consumer : "?");
+                fflush(stderr);
+            }
+        }
+        return;
+    }
+    const size_t nb = it->second.nbytes;
+    if (ggml_nbytes(t) != nb) return;
+    // Only the SAME tensor changing counts. A different name at the same address
+    // is the allocator reusing storage after raw_k's last use -- which is what it
+    // is for, not a fault. The first version compared by address alone and duly
+    // reported q_b-N sitting on a former raw_k address as a "change".
+    if (strcmp(t->name, it->second.name) != 0) return;
+    std::vector<uint16_t> tmp(nb/2);
+    ggml_backend_tensor_get((struct ggml_tensor *) t, tmp.data(), 0, nb);
+    const uint64_t now = ik_sum16(tmp.data(), tmp.size());
+    static long long checked = 0, bad = 0;
+    ++checked;
+    if (now != it->second.sum) {
+        ++bad;
+        size_t nan = 0;
+        for (size_t i = 0; i < tmp.size(); ++i) if ((tmp[i] & 0x7FFFu) > 0x7C00u) ++nan;
+        fprintf(stderr, "IK_LIFETIME: %s CHANGED between copy and use by %s -- %zu NaN of %zu f16\n",
+                t->name, consumer ? consumer : "?", nan, tmp.size());
+        fflush(stderr);
+    }
+    if (checked == 1 || checked % 500 == 0) {
+        fprintf(stderr, "IK_LIFETIME: alive, %lld verified, %lld changed\n", checked, bad);
+        fflush(stderr);
+    }
+}
+// ===== end IK_LIFETIME =====
+
+static bool ik_rawk_guard(void) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_RAWK_GUARD"); on = (e && atoi(e) == 0) ? 0 : 1; }
+    return on == 1;
+}
+
+static void ik_copy_check_src(const char * where, const struct ggml_tensor * t, const char * dstname) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_COPY_CHECK"); on = (e && atoi(e)) ? 1 : 0; }
+    if (on != 1 || !t || !t->data) return;
+
+    static long long calls = 0, checked = 0;
+    ++calls;
