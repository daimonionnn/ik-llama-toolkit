+    if (i >= n) return;
+    float v = x[i];
+    // NaN only. inf is NOT an error here: attention masks are built out of
+    // -INFINITY, so flagging inf produced 1386 hits on a single healthy request
+    // -- from SCALE and FILL nodes doing exactly what they should.
+    if (isnan(v)) {
+        atomicCAS(&g_nan_node, -1, node_idx); atomicExch(&g_nan_kind, 1);
+        // WHERE in the tensor, not just whether: if every NaN sits past the
+        // logical end of the data, this is uninitialised padding being read
+        // rather than a poisoned value being computed.
+        atomicMin(&g_nan_first_idx, (int) i);
+        atomicAdd(&g_nan_count, 1);
+    }
+}
+
+static __global__ void k_nan_probe_f16(const half * x, int64_t n, int node_idx) {
+    int64_t i = (int64_t)blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    float v = __half2float(x[i]);
+    // NaN only. inf is NOT an error here: attention masks are built out of
+    // -INFINITY, so flagging inf produced 1386 hits on a single healthy request
+    // -- from SCALE and FILL nodes doing exactly what they should.
+    if (isnan(v)) {
+        atomicCAS(&g_nan_node, -1, node_idx); atomicExch(&g_nan_kind, 1);
+        // WHERE in the tensor, not just whether: if every NaN sits past the
+        // logical end of the data, this is uninitialised padding being read
+        // rather than a poisoned value being computed.
+        atomicMin(&g_nan_first_idx, (int) i);
+        atomicAdd(&g_nan_count, 1);
+    }
+}
+
+// ===== IK_SUM_CHECK: in-stream deposit checksums (RESULTS 46) ==============
+// The strongest surviving fact (45) is that a split-input copy changes between
+// its deposit and its consumption. Every probe so far could only see the NaN
+// special case of that, and only post-hoc. This one measures the fact itself:
+//   mark   -- right after the deposit, a kernel on the compute stream sums the
+//             copy's bytes into a slot
+//   verify -- right before each consumer, a second kernel re-sums and a third
+//             compares, latching the first mismatch
+// All in-stream, no synchronisation while clean, so races stay live. And it is
+// an AMPLIFIER: it catches ANY mutation, not just the ~3% that read as NaN --
+// the fault should announce itself far more often than once per 250k tokens.
+// Requires GGML_CUDA_DISABLE_GRAPHS=1: marks run per iteration outside any
+// captured graph, so slots would go stale under capture/replay.
+// Blind spot, accepted and documented: a writer QUEUED EARLIER on the compute
+// stream that runs between the deposit and the mark is summed into the
+// baseline and missed. Out-of-stream writers -- the H2 class -- are caught.
+#define IK_SUM_SLOTS 65536
+
+__device__ unsigned long long ik_sum_base[IK_SUM_SLOTS];
+__device__ unsigned long long ik_sum_chk [IK_SUM_SLOTS];
+__device__ int ik_sum_hit_node = -1;   // consumer node idx of FIRST mismatch
+__device__ int ik_sum_hit_src  = -1;
+__device__ int ik_sum_hit_slot = -1;
+__device__ unsigned long long ik_sum_hit_count = 0;
+
+static __global__ void k_ik_sum_zero(unsigned long long * out) { *out = 0; }
+
+static __global__ void k_ik_sum(const uint8_t * p, size_t nbytes, unsigned long long * out) {
+    __shared__ unsigned long long sh;
+    if (threadIdx.x == 0) sh = 0;
+    __syncthreads();
+    unsigned long long acc = 0;
+    const size_t n32 = nbytes >> 2;
+    const uint32_t * p32 = (const uint32_t *) p;
+    for (size_t i = (size_t)blockIdx.x*blockDim.x + threadIdx.x; i < n32; i += (size_t)gridDim.x*blockDim.x) {
+        acc += p32[i];
+    }
+    if (blockIdx.x == 0 && threadIdx.x == 0) {
+        for (size_t i = nbytes & ~(size_t)3; i < nbytes; ++i) acc += p[i];
+    }
+    atomicAdd(&sh, acc);
+    __syncthreads();
+    if (threadIdx.x == 0) atomicAdd(out, sh);
+}
+
+static __global__ void k_ik_sum_cmp(int slot, int node, int src) {
+    if (ik_sum_base[slot] != ik_sum_chk[slot]) {
+        atomicAdd(&ik_sum_hit_count, 1ULL);
+        if (atomicCAS(&ik_sum_hit_node, -1, node) == -1) {
+            ik_sum_hit_src  = src;
+            ik_sum_hit_slot = slot;
+        }
+    }
+}
+
+__device__ int ik_fa_hit_node = -1;
+__device__ unsigned long long ik_fa_hit_a = 0, ik_fa_hit_b = 0;
+__device__ unsigned long long ik_fa_hit_count = 0;
+
+__device__ int ik_mask_hit_node = -1;
+__device__ int ik_mask_hit_row  = -1;
+__device__ unsigned long long ik_mask_hit_count = 0;
+
+// One block per mask row (query token). Latch any row with NO finite entry --
+// the classic softmax 0/0 configuration that produces NaN deterministically.
+static __global__ void k_ik_mask_scan(const half * mask, int64_t n_kv, size_t row_stride_half, int node) {
+    __shared__ int any_finite;
+    if (threadIdx.x == 0) any_finite = 0;
+    __syncthreads();
+    const half * row = mask + (size_t) blockIdx.x * row_stride_half;
+    for (int64_t i = threadIdx.x; i < n_kv && !any_finite; i += blockDim.x) {
+        const unsigned short u = __half_as_ushort(row[i]);
+        if (u != 0xFC00u) { any_finite = 1; break; }   // 0xFC00 = -inf
+    }
+    __syncthreads();
+    if (threadIdx.x == 0 && !any_finite) {
+        atomicAdd(&ik_mask_hit_count, 1ULL);
+        atomicCAS(&ik_mask_hit_node, -1, node);
+        atomicCAS(&ik_mask_hit_row,  -1, (int) blockIdx.x);
+    }
+}
+
+static __global__ void k_ik_fa_cmp(int slot_a, int slot_b, int node) {
+    if (ik_sum_base[slot_a] != ik_sum_chk[slot_b]) {
+        atomicAdd(&ik_fa_hit_count, 1ULL);
+        if (atomicCAS(&ik_fa_hit_node, -1, node) == -1) {
+            ik_fa_hit_a = ik_sum_base[slot_a];
+            ik_fa_hit_b = ik_sum_chk [slot_b];
+        }
+    }
+}
+
+// ===== fattn-0 input capture (RESULTS 47.2) ================================
+// Armed from the server's catch right before the in-place replay of the failing
+// batch. Captures the exact device bytes of fattn-0's inputs -- the true
+// minimal reproducer for the deterministic kernel NaN -- then disarms.
+// ORIGIN STAGING (RESULTS 47.5): pinned-host copies of fattn-0's inputs,
+// refreshed every prefill graph by stream-ordered D2H right before the node --
+// so they hold exactly the bytes the kernel read, and galloc can never
+// recycle them. Written to disk by ik_nan_report on a latch.
+struct ik_stage_slot {
+    void * host = nullptr; size_t cap = 0; size_t nbytes = 0;
+    int64_t hdr[10] = {0}; char name[96] = {0}; bool valid = false;
+};
+static ik_stage_slot ik_stage[GGML_MAX_SRC];
+
+static void ik_stage_src(ggml_backend_cuda_context & ctx, const ggml_tensor * src, int k) {
+    ik_stage_slot & sl = ik_stage[k];
+    sl.valid = false;
+    if (!src || !src->data) return;
+    const size_t nbytes = ggml_nbytes(src);
+    if (nbytes > sl.cap) {
+        if (sl.host) cudaFreeHost(sl.host);
+        sl.host = nullptr; sl.cap = 0;
+        if (cudaMallocHost(&sl.host, nbytes) != cudaSuccess) { sl.host = nullptr; return; }
+        sl.cap = nbytes;
+    }
+    sl.nbytes = nbytes;
+    int64_t * h = sl.hdr;
+    h[0] = (int64_t) src->type;
+    h[1]=src->ne[0]; h[2]=src->ne[1]; h[3]=src->ne[2]; h[4]=src->ne[3];
+    h[5]=(int64_t)src->nb[0]; h[6]=(int64_t)src->nb[1]; h[7]=(int64_t)src->nb[2]; h[8]=(int64_t)src->nb[3];
+    h[9]=(int64_t)nbytes;
+    snprintf(sl.name, sizeof(sl.name), "%s", src->name);
+    CUDA_CHECK(cudaMemcpyAsync(sl.host, src->data, nbytes, cudaMemcpyDeviceToHost, ctx.stream()));
+    sl.valid = true;
+}
+
+static char ik_fattn_capture_dir[256] = {0};
+static int  ik_fattn_capture_state = 0;   // 0 idle, 1 armed, 2 done
+
+extern "C" void ik_fattn_capture_disarm(void) {
+    if (ik_fattn_capture_state == 1) ik_fattn_capture_state = 0;
+}
+
+extern "C" void ik_fattn_capture_arm(const char * dir) {
+    snprintf(ik_fattn_capture_dir, sizeof(ik_fattn_capture_dir), "%s", dir);
+    ik_fattn_capture_state = 1;
+}
+extern "C" int ik_fattn_capture_done(void) { return ik_fattn_capture_state == 2 ? 1 : 0; }
+
+static void ik_fattn_capture_write(const ggml_tensor * t, const char * path) {
+    const size_t nbytes = ggml_nbytes(t);
+    std::vector<uint8_t> buf(nbytes);
+    CUDA_CHECK(cudaMemcpy(buf.data(), t->data, nbytes, cudaMemcpyDeviceToHost));
+    FILE * f = fopen(path, "wb");
+    if (!f) return;
+    int64_t hdr[10] = { (int64_t) t->type,
+                        t->ne[0], t->ne[1], t->ne[2], t->ne[3],
+                        (int64_t) t->nb[0], (int64_t) t->nb[1], (int64_t) t->nb[2], (int64_t) t->nb[3],
+                        (int64_t) nbytes };
+    fwrite(hdr, sizeof(hdr), 1, f);
+    fwrite(buf.data(), 1, nbytes, f);
+    fclose(f);
+}
+
+extern "C" bool ik_fa_twice_enabled(void) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_FA_TWICE"); on = (e && atoi(e)) ? 1 : 0; }
+    return on == 1;
+}
+
+extern "C" bool ik_sum_check_enabled(void) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_SUM_CHECK"); on = (e && atoi(e)) ? 1 : 0; }
+    return on == 1;
+}
+
+struct ik_sum_entry { int slot; size_t nbytes; };
+static std::unordered_map<const void *, ik_sum_entry> ik_sum_map;  // key: tensor struct ptr
+static int       ik_sum_next_slot = 0;
+static long long ik_sum_marks = 0, ik_sum_verifies = 0;
+static long long ik_fa_runs = 0;
+
+// Stale entries are poison: the sched graph arena reuses addresses every pass,
+// so an old entry can point a fresh tensor at a dead slot with the wrong size.
+// Cleared at every compute_splits entry.
+extern "C" void ik_sum_clear(void) {
+    ik_sum_map.clear();
+}
+
+static unsigned long long * ik_sum_base_ptr(void) {
+    static unsigned long long * p = nullptr;
+    if (!p) CUDA_CHECK(cudaGetSymbolAddress((void **) &p, ik_sum_base));
+    return p;
+}
+static unsigned long long * ik_sum_chk_ptr(void) {
+    static unsigned long long * p = nullptr;
+    if (!p) CUDA_CHECK(cudaGetSymbolAddress((void **) &p, ik_sum_chk));
+    return p;
+}
+
+// called from ggml-backend.cpp right after each split-input deposit
+extern "C" void ik_sum_mark_tensor(ggml_backend_t backend, const struct ggml_tensor * t) {
+    if (!ik_sum_check_enabled() || !t || !t->data) return;
+    if (!ggml_backend_is_cuda(backend)) return;
+    ggml_backend_cuda_context * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    const size_t nbytes = ggml_nbytes(t);
+    if (nbytes == 0) return;
+    const int slot = (ik_sum_next_slot++) & (IK_SUM_SLOTS - 1);
+    ik_sum_map[(const void *) t] = { slot, nbytes };
+    if (++ik_sum_marks % 5000 == 1) {
+        fprintf(stderr, "IK_SUM_CHECK: mark #%lld (%s, %zu B, slot %d)\n",
+                ik_sum_marks, t->name, nbytes, slot);
+        fflush(stderr);
+    }
+    unsigned long long * out = ik_sum_base_ptr() + slot;
+    k_ik_sum_zero<<<1, 1, 0, ctx->stream()>>>(out);
+    const int64_t grid = std::min<int64_t>(1024, ((int64_t)(nbytes >> 2) + 255) / 256 + 1);
+    k_ik_sum<<<grid, 256, 0, ctx->stream()>>>((const uint8_t *) t->data, nbytes, out);
+}
+
+static void ik_sum_verify_srcs(ggml_backend_cuda_context & ctx, const ggml_tensor * dst, int node_idx) {
+    for (int j = 0; j < GGML_MAX_SRC; ++j) {
+        const ggml_tensor * src = dst->src[j];
+        if (!src) continue;
+        auto it = ik_sum_map.find((const void *) src);
+        if (it == ik_sum_map.end()) continue;
+        const int slot = it->second.slot;
+        const size_t nbytes = it->second.nbytes;
+        ++ik_sum_verifies;
+        unsigned long long * out = ik_sum_chk_ptr() + slot;
+        k_ik_sum_zero<<<1, 1, 0, ctx.stream()>>>(out);
+        const int64_t grid = std::min<int64_t>(1024, ((int64_t)(nbytes >> 2) + 255) / 256 + 1);
+        k_ik_sum<<<grid, 256, 0, ctx.stream()>>>((const uint8_t *) src->data, nbytes, out);
+        k_ik_sum_cmp<<<1, 1, 0, ctx.stream()>>>(slot, node_idx, j);
+    }
+}
+
+static void ik_sum_report(ggml_backend_cuda_context & ctx, const ggml_cgraph * cgraph) {
+    if (!ik_sum_check_enabled()) return;
+
+    // liveness -- a probe that only speaks on failure is indistinguishable from
+    // one that never ran (RESULTS 38.1)
+    static long long n_calls = 0;
+    if (++n_calls % 2000 == 1) {
+        fprintf(stderr, "IK_SUM_CHECK: alive, %lld marks / %lld verifies / %lld FA double-runs so far\n",
+                ik_sum_marks, ik_sum_verifies, ik_fa_runs);
+        fflush(stderr);
+    }
+
+    // mask-scan latch: read together with the FA latch below (same cadence)
+    if (ik_fa_twice_enabled()) {
+        static int * h_mask = nullptr;
+        if (!h_mask) {
+            CUDA_CHECK(cudaMallocHost((void **) &h_mask, sizeof(int)));
+            h_mask[0] = -1;
+        }
+        if (h_mask[0] >= 0) {
+            CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+            int node = -1, row = -1; unsigned long long cnt = 0;
+            CUDA_CHECK(cudaMemcpyFromSymbol(&node, ik_mask_hit_node,  sizeof(node)));
+            CUDA_CHECK(cudaMemcpyFromSymbol(&row,  ik_mask_hit_row,   sizeof(row)));
+            CUDA_CHECK(cudaMemcpyFromSymbol(&cnt,  ik_mask_hit_count, sizeof(cnt)));
+            const ggml_tensor * nt = (cgraph && node >= 0 && node < cgraph->n_nodes) ? cgraph->nodes[node] : nullptr;
+            fprintf(stderr, "\nIK_MASK_SCAN: FULLY-MASKED ROW -- softmax 0/0 configuration present\n"
+                            "  node %d (%s), mask row %d, %llu such rows this pass\n",
+                    node, nt ? nt->name : "?", row, cnt);
+            fflush(stderr);
+            int r = -1; unsigned long long z = 0;
+            CUDA_CHECK(cudaMemcpyToSymbol(ik_mask_hit_node,  &r, sizeof(r)));
+            CUDA_CHECK(cudaMemcpyToSymbol(ik_mask_hit_row,   &r, sizeof(r)));
+            CUDA_CHECK(cudaMemcpyToSymbol(ik_mask_hit_count, &z, sizeof(z)));
+            h_mask[0] = -1;
+        } else {
+            CUDA_CHECK(cudaMemcpyFromSymbolAsync(h_mask, ik_mask_hit_node, sizeof(int), 0,
+                                                 cudaMemcpyDeviceToHost, ctx.stream()));
+        }
+    }
+
+    // FA-twice latch, same async pinned pattern
+    if (ik_fa_twice_enabled()) {
+        static int * h_fa = nullptr;
+        if (!h_fa) {
+            CUDA_CHECK(cudaMallocHost((void **) &h_fa, sizeof(int)));
+            h_fa[0] = -1;
+        }
+        if (h_fa[0] >= 0) {
+            CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+            int node = -1; unsigned long long a = 0, b = 0, cnt = 0;
+            CUDA_CHECK(cudaMemcpyFromSymbol(&node, ik_fa_hit_node,  sizeof(node)));
+            CUDA_CHECK(cudaMemcpyFromSymbol(&a,    ik_fa_hit_a,     sizeof(a)));
+            CUDA_CHECK(cudaMemcpyFromSymbol(&b,    ik_fa_hit_b,     sizeof(b)));
+            CUDA_CHECK(cudaMemcpyFromSymbol(&cnt,  ik_fa_hit_count, sizeof(cnt)));
+            const ggml_tensor * nt = (cgraph && node >= 0 && node < cgraph->n_nodes) ? cgraph->nodes[node] : nullptr;
+            fprintf(stderr, "\nIK_FA_TWICE: NONDETERMINISM -- same node, same inputs, two different outputs\n"
+                            "  node %d, tensor %s: run1 sum %llu != run2 sum %llu (%llu divergences this pass)\n",
+                    node, nt ? nt->name : "?", a, b, cnt);
+            fflush(stderr);
+            int r = -1; unsigned long long z = 0;
+            CUDA_CHECK(cudaMemcpyToSymbol(ik_fa_hit_node,  &r, sizeof(r)));
+            CUDA_CHECK(cudaMemcpyToSymbol(ik_fa_hit_count, &z, sizeof(z)));
+            h_fa[0] = -1;
+        } else {
+            CUDA_CHECK(cudaMemcpyFromSymbolAsync(h_fa, ik_fa_hit_node, sizeof(int), 0,
+                                                 cudaMemcpyDeviceToHost, ctx.stream()));
+        }
+    }
+
+    // async pinned readback -- no synchronisation while clean (RESULTS 44.6)
+    static int * h_hit = nullptr;
+    if (!h_hit) {
+        CUDA_CHECK(cudaMallocHost((void **) &h_hit, sizeof(int)));
+        h_hit[0] = -1;
+    }
+    if (h_hit[0] < 0) {
+        CUDA_CHECK(cudaMemcpyFromSymbolAsync(h_hit, ik_sum_hit_node, sizeof(int), 0,
+                                             cudaMemcpyDeviceToHost, ctx.stream()));
+        return;
+    }
+    // a mismatch latched: the fault already happened, syncing now costs nothing
+    CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+    int node = -1, src = -1, slot = -1; unsigned long long cnt = 0, vbase = 0, vchk = 0;
+    CUDA_CHECK(cudaMemcpyFromSymbol(&node, ik_sum_hit_node,  sizeof(node)));
+    CUDA_CHECK(cudaMemcpyFromSymbol(&src,  ik_sum_hit_src,   sizeof(src)));
+    CUDA_CHECK(cudaMemcpyFromSymbol(&slot, ik_sum_hit_slot,  sizeof(slot)));
+    CUDA_CHECK(cudaMemcpyFromSymbol(&cnt,  ik_sum_hit_count, sizeof(cnt)));
+    if (slot >= 0) {
+        CUDA_CHECK(cudaMemcpy(&vbase, ik_sum_base_ptr() + slot, sizeof(vbase), cudaMemcpyDeviceToHost));
+        CUDA_CHECK(cudaMemcpy(&vchk,  ik_sum_chk_ptr()  + slot, sizeof(vchk),  cudaMemcpyDeviceToHost));
+    }
+    const ggml_tensor * nt = (cgraph && node >= 0 && node < cgraph->n_nodes) ? cgraph->nodes[node] : nullptr;
+    fprintf(stderr, "\nIK_SUM_CHECK: MISMATCH -- copy changed between deposit and consumption\n"
+                    "  consumer : node %d, op %s, tensor %s\n"
+                    "  input    : src[%d] = %s\n"
+                    "  sums     : deposit %llu -> consume %llu (slot %d, %llu mismatches this pass)\n",
+            node, nt ? ggml_op_name(nt->op) : "?", nt ? nt->name : "?",
+            src, (nt && src >= 0 && nt->src[src]) ? nt->src[src]->name : "?",
+            vbase, vchk, slot, cnt);
+    fflush(stderr);
+    int reset = -1; unsigned long long zero = 0;
+    CUDA_CHECK(cudaMemcpyToSymbol(ik_sum_hit_node,  &reset, sizeof(reset)));
+    CUDA_CHECK(cudaMemcpyToSymbol(ik_sum_hit_src,   &reset, sizeof(reset)));
+    CUDA_CHECK(cudaMemcpyToSymbol(ik_sum_hit_slot,  &reset, sizeof(reset)));
+    CUDA_CHECK(cudaMemcpyToSymbol(ik_sum_hit_count, &zero,  sizeof(zero)));
+    h_hit[0] = -1;
+}
+
+// ===== IK_NAN_CHECK input probes (RESULTS 44.5) ===========================
+// The per-input "ALREADY NaN" annotations in ik_nan_report read memory AFTER the
+// graph finishes, when the copies' regions have been legally freed and reused --
+// which is how 36-40 misattributed the origin. These kernels check the INPUTS of
+// FLASH_ATTN_EXT on the compute stream IMMEDIATELY BEFORE the node runs:
+// stream-ordered, no synchronisation, so a race stays live, and they observe
+// exactly the bytes the kernel will read.
+//   packed flag: node_idx * 16 + src_idx, CAS from -1 keeps the earliest.
+__device__ int g_nan_in_packed = -1;
+
+static __global__ void k_nan_probe_in_f32(const float * x, int64_t n, int packed) {
+    int64_t i = (int64_t)blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    if (isnan(x[i])) atomicCAS(&g_nan_in_packed, -1, packed);
+}
+
+static __global__ void k_nan_probe_in_f16(const half * x, int64_t n, int packed) {
+    int64_t i = (int64_t)blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const unsigned short u = __half_as_ushort(x[i]);
+    if ((u & 0x7FFFu) > 0x7C00u) atomicCAS(&g_nan_in_packed, -1, packed);
+}
+
+static bool ik_nan_check_enabled() {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_NAN_CHECK"); on = (e && atoi(e)) ? 1 : 0; }
+    return on == 1;
+}
+
+// Returns true if the tensor contains a NaN. Synchronous, so ONLY call it from
+// ik_nan_report -- after capture has ended.
+static bool ik_tensor_has_nan(ggml_backend_cuda_context & ctx, const ggml_tensor * t) {
+    if (!t || !t->data) return false;
+    if (t->type != GGML_TYPE_F32 && t->type != GGML_TYPE_F16) return false;
+    const int64_t n = ggml_nelements(t);
+    if (n <= 0) return false;
+    int reset = -1, big = 2147483647, zero = 0;
+    CUDA_CHECK(cudaMemcpyToSymbol(g_nan_node, &reset, sizeof(reset)));
+    CUDA_CHECK(cudaMemcpyToSymbol(g_nan_first_idx, &big, sizeof(big)));
+    CUDA_CHECK(cudaMemcpyToSymbol(g_nan_count, &zero, sizeof(zero)));
+    const int64_t block = 256, grid = (n + block - 1)/block;
+    if (grid > 2147483647LL) return false;
+    if (t->type == GGML_TYPE_F32) k_nan_probe_f32<<<grid, block, 0, ctx.stream()>>>((const float *) t->data, n, 1);
+    else                          k_nan_probe_f16<<<grid, block, 0, ctx.stream()>>>((const half  *) t->data, n, 1);
+    CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+    int hit = -1;
+    CUDA_CHECK(cudaMemcpyFromSymbol(&hit, g_nan_node, sizeof(hit)));
+    return hit >= 0;
+}
+
+static void ik_nan_probe(ggml_backend_cuda_context & ctx, const ggml_tensor * dst, int node_idx) {
+    if (!ik_nan_check_enabled() || !dst || !dst->data) return;
+    const int64_t n = ggml_nelements(dst);
+    if (n <= 0) return;
+    const int64_t block = 256, grid = (n + block - 1)/block;
+    if (grid > 2147483647LL) return;
+    if (dst->type == GGML_TYPE_F32) {
+        k_nan_probe_f32<<<grid, block, 0, ctx.stream()>>>((const float *) dst->data, n, node_idx);
+    } else if (dst->type == GGML_TYPE_F16) {
