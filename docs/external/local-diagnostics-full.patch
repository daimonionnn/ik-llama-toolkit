+// a node output. This scans layer 0's K cache from the host after each decode
+// and reports the FIRST decode after which NaN is present, with what that
+// decode was doing. Requires -nkvo (cache in host memory); silently does
+// nothing if the buffer is not host-resident. Off unless IK_KV_SCAN=1.
+static bool ik_kv_scan_enabled() {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_KV_SCAN"); on = (e && atoi(e)) ? 1 : 0; }
+    return on == 1;
+}
+
+static void ik_kv_scan(llama_context & lctx, int32_t n_tokens_batch, const char * phase) {
+    if (!ik_kv_scan_enabled()) return;
+    auto & kv = lctx.kv_self;
+    if (kv.k_l.empty()) return;
+    // Which layer to scan. It was 0, and layer 0 is one of the three that is
+    // NEVER poisoned (RESULTS 39) -- so four aborts' worth of "cache is clean"
+    // meant only "layer 0 is clean". Default 4: the lowest layer that shows the
+    // full 80.9 % pattern. Scanning all 43 would be 5.8 GB per decode.
+    static int scan_layer = -1;
+    if (scan_layer < 0) {
+        const char * e = getenv("IK_KV_SCAN_LAYER");
+        scan_layer = e ? atoi(e) : 4;
+    }
+    if (scan_layer < 0 || scan_layer >= (int) kv.k_l.size()) return;
+    ggml_tensor * k0 = kv.k_l[scan_layer];
+    if (!k0 || !k0->data || k0->type != GGML_TYPE_F16) return;
+    if (k0->buffer && !ggml_backend_buffer_is_host(k0->buffer)) return;
+
+    // Writes land async on the backend stream; sync before reading.
+    ggml_backend_sched_synchronize(lctx.sched);
+
+    // Row layout: ne[0] f16 per cell. Scan only cells that carry data --
+    // untouched cells beyond that are legitimately uninitialised.
+    // Scan the WHOLE tensor, and report live and beyond-live separately.
+    // The first version scanned only max(head, used) cells and reported nothing
+    // while attention was demonstrably reading NaN out of this very tensor --
+    // DeepSeek-V4 compacts rows and windows them (kv.row_count, size_swa), so
+    // head/used does not describe layer 0's occupancy and the scan was looking
+    // at the wrong range.
+    const int64_t per_cell = k0->ne[0];
+    const int64_t n = (int64_t) ggml_nelements(k0);
+    if (n <= 0) return;
+    const uint32_t live_rows = kv.rows(0);
+    const int64_t  live_n    = std::min(n, (int64_t) live_rows * per_cell);
+
+    const uint16_t * d = (const uint16_t *) k0->data;
+    int64_t first = -1, cnt = 0, cnt_live = 0;
+    for (int64_t i = 0; i < n; ++i) {
+        // f16 NaN: exponent all ones, mantissa nonzero
+        if ((d[i] & 0x7FFFu) > 0x7C00u) {
+            if (first < 0) first = i;
+            ++cnt;
+            if (i < live_n) ++cnt_live;
+        }
+    }
+    const uint32_t cells = live_rows;
+
+    static int64_t decode_no = 0;      // counts scanned decodes
+    static bool was_poisoned_pre = false, was_poisoned_post = false;
+    const bool is_pre = phase[0] == 'p' && phase[1] == 'r';
+    bool & was_poisoned = is_pre ? was_poisoned_pre : was_poisoned_post;
+    if (!is_pre) ++decode_no;
+    const bool poisoned = cnt > 0;
+    // Heartbeat, so "nothing reported" can be told apart from "never ran" --
+    // the distinction the first version could not make.
+    if (decode_no == 1 || decode_no % 500 == 0) {
+        fprintf(stderr, "IK_KV_SCAN: alive [%s] layer %d, decode #%lld, scanned %lld elems (%u live rows), %lld NaN (%lld live)\n",
+                phase, scan_layer, (long long) decode_no, (long long) n, live_rows, (long long) cnt, (long long) cnt_live);
+        fflush(stderr);
+    }
+    if (poisoned && !was_poisoned) {
+        fprintf(stderr, "\n=============================== IK_KV_SCAN [%s]: layer-%d K cache went CLEAN -> POISONED\n"
+                        "  decode #%lld: batch of %d tokens, kv head=%u used=%u n=%u\n"
+                        "  first NaN at cell %lld dim %lld, %lld NaN total (%lld inside %u live rows)\n",
+                phase, scan_layer, (long long) decode_no, n_tokens_batch, kv.head, kv.used, kv.n,
+                (long long)(first/per_cell), (long long)(first%per_cell), (long long) cnt, (long long) cnt_live, cells);
+        fflush(stderr);
+    } else if (!poisoned && was_poisoned) {
+        fprintf(stderr, "IK_KV_SCAN [%s]: layer-%d K cache POISONED -> CLEAN (decode #%lld, kv head=%u used=%u)\n",
+                phase, scan_layer, (long long) decode_no, kv.head, kv.used);
+        fflush(stderr);
+    }
+    was_poisoned = poisoned;
+}
+// ===== end IK_KV_SCAN =================================================
