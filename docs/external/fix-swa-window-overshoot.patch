diff --git a/src/graphs/build_deepseek4.cpp b/src/graphs/build_deepseek4.cpp
index d3fefc8b..f3a0783a 100644
--- a/src/graphs/build_deepseek4.cpp
+++ b/src/graphs/build_deepseek4.cpp
@@ -1133,6 +1133,28 @@ static ggml_tensor * ds4_attention(ggml_cgraph * gf, ggml_context * ctx0, llm_bu
         int ntokens = std::max(k_fa_chunk, int(q->ne[2]));
         int nton = k_fa_chunk*((ntokens + n_swa + k_fa_chunk - 1)/k_fa_chunk);
         int first = raw_k->ne[2] - nton;
+        // LOCAL FIX (ik-llama-toolkit), RESULTS 49.2. `first` is derived from
+        // raw_k->ne[2], i.e. the 256-PADDED kv length, while the mask rows are
+        // indexed from kv_head. When the padding slack exceeds the window slack
+        // (which needs a non-256-aligned kv_head, i.e. prompt-cache reuse), the
+        // view starts AFTER the cells the leading rows need: those rows come out
+        // entirely -inf, and FLASH_ATTN_EXT turns them into NaN. Even short of
+        // that, the same overshoot silently truncates the window of the first
+        // rows. The window must never start later than the oldest cell row 0
+        // still needs.
+        if (int max_first = (int) llm.kv_head - n_swa + 1; first > max_first) {
+            first = max_first;
+        }
+        // IK_SWA_DBG: diagnostic for the above, kept because it is what found
+        // the fault. Cached so the disabled path costs one branch.
+        static const bool swa_dbg = getenv("IK_SWA_DBG") != nullptr;
+        if (swa_dbg) {
+            fprintf(stderr, "IK_SWA_DBG: il=%d kv_head=%d n_tokens=%d raw_k_ne2=%d nton=%d first=%d offset=%d%s\n",
+                    il, (int) llm.kv_head, (int) q->ne[2], (int) raw_k->ne[2], nton, first,
+                    first - (int) llm.kv_head,
+                    (first - (int) llm.kv_head) > 0 ? "   <<<< EMPTY LEADING ROWS" : "");
+            fflush(stderr);
+        }
         if (first > 0) {
             raw_k = ggml_view_4d(ctx0, raw_k, raw_k->ne[0], raw_k->ne[1], nton, raw_k->ne[3],
                     raw_k->nb[1], raw_k->nb[2], raw_k->nb[3], raw_k->nb[2]*first);
