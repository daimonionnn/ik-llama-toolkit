+// IK_COPY_CHECK -- placed on the two low-level entry points every copy funnels
+// through, after three attempts at guessing the right branch in the scheduler
+// each landed somewhere raw_k never goes. The heartbeat is what caught that: a
+// counter of 1 over 35 000 prefilled tokens meant "this path is not used", not
+// "the data is clean". RESULTS 36.9 and 38.6.
+// IK_DST_CHECK: read the DESTINATION back immediately after the copy and compare
+// it with the source. RESULTS 40.5: CUDA0#raw_k-0 is NaN on the device while the
+// host bytes it came from are clean, and that is the one step in the chain with
+// no measurement behind it. Only for the tensors that matter, because a device
+// readback per copy would be ruinous.
+static bool ik_dst_check_wanted(const struct ggml_tensor * src, const struct ggml_tensor * dst) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_DST_CHECK"); on = (e && atoi(e)) ? 1 : 0; }
+    if (on != 1 || !src || !dst) return false;
+    if (src->type != GGML_TYPE_F16) return false;
+    // layers 0 and 1 only -- the uncompressed ones, where the poison starts
+    return strncmp(src->name, "raw_k-0", 7) == 0 || strncmp(src->name, "raw_k-1", 7) == 0;
+}
+
+static void ik_dst_check_after(const struct ggml_tensor * src, const struct ggml_tensor * dst) {
+    const size_t nb = ggml_nbytes(src);
+    const size_t n16 = nb / 2;
+    std::vector<uint16_t> buf(n16);
+    ggml_backend_tensor_get(dst, buf.data(), 0, nb);
+
+    const uint16_t * h = (const uint16_t *) src->data;
+    size_t src_nan = 0, dst_nan = 0, first_dst = 0, diff = 0;
+    for (size_t i = 0; i < n16; ++i) {
+        const bool sn = (h[i]      & 0x7FFFu) > 0x7C00u;
+        const bool dn = (buf[i]    & 0x7FFFu) > 0x7C00u;
+        if (sn) ++src_nan;
+        if (dn) { if (dst_nan == 0) first_dst = i; ++dst_nan; }
+        if (h[i] != buf[i]) ++diff;
+    }
+    static long long calls = 0;
+    ++calls;
+    if (dst_nan || diff) {
+        fprintf(stderr, "IK_DST_CHECK: %s -> %s: src_nan=%zu dst_nan=%zu (first %zu) differing=%zu of %zu\n",
+                src->name, dst->name, src_nan, dst_nan, first_dst, diff, n16);
+        fflush(stderr);
+    }
+    if (calls == 1 || calls % 100 == 0) {
+        fprintf(stderr, "IK_DST_CHECK: alive, %lld destination reads compared\n", calls);
+        fflush(stderr);
+    }
+}
+
+static void ik_copy_check_src(const char * where, const struct ggml_tensor * t, const char * dstname) {
+    static int on = -1;
+    if (on < 0) { const char * e = getenv("IK_COPY_CHECK"); on = (e && atoi(e)) ? 1 : 0; }
+    if (on != 1 || !t || !t->data) return;
+
+    static long long calls = 0, checked = 0;
+    ++calls;
+    if (t->type == GGML_TYPE_F16 && t->buffer && ggml_backend_buffer_is_host(t->buffer)) {
+        ++checked;
+        const size_t n16 = ggml_nbytes(t) / 2;
+        const uint16_t * h = (const uint16_t *) t->data;
+        size_t first = 0, cnt = 0;
+        for (size_t i = 0; i < n16; ++i) {
+            if ((h[i] & 0x7FFFu) > 0x7C00u) { if (cnt == 0) first = i; ++cnt; }
+        }
+        if (cnt) {
+            fprintf(stderr, "IK_COPY_CHECK [%s]: HOST source already NaN: %s -> %s, %zu of %zu f16, first at %zu\n",
+                    where, t->name, dstname ? dstname : "?", cnt, n16, first);
+            fflush(stderr);
+        }
+    }
+    if (calls == 1 || calls % 2000 == 0) {
+        fprintf(stderr, "IK_COPY_CHECK: alive, %lld copies seen, %lld host-f16 scanned\n", calls, checked);
+        fflush(stderr);
+    }
+}
