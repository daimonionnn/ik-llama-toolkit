@@ -4797,6 +4808,156 @@ void server_context::process_batch_tokens(int32_t & n_batch) {
                     {"error", e.what()},
                 });
                 send_error(slot, std::string("sampling error: ") + e.what(), ERROR_TYPE_SERVER);
+
+                // LOCAL PATCH (ik-llama-toolkit): drop this slot's cached state.
+                //
+                // release() alone resets the slot but keeps cache_tokens, the KV
+                // cells and the checkpoints. The state that just produced NaN
+                // logits would therefore be REUSED by the next request carrying
+                // the same prefix -- and a retry is exactly what an agent client
+                // does with a 500. Either it aborts again and the agent spins, or
+                // it does not and the answer is silently degraded. The second is
+                // worse, because nothing reports it.
+                //
+                // We do not know whether the NaN originates in the KV or in the
+                // arithmetic of that one batch (RESULTS 32 -- the cause is open),
+                // so this is not a fix. It is refusing to build on a state that
+                // has demonstrably gone wrong. Cost is one full prefill on the
+                // retry; cheap against a quietly wrong answer.
+                //
+                // LOCAL PATCH (ik-llama-toolkit), RESULTS 47: dump-on-abort.
+                // 46.4 proved fattn-0 computes NaN deterministically from clean
+                // inputs, so the poisoned state IS the reproducer -- and the
+                // next line is about to erase it. Save it first: the token
+                // history (layer-0 Q depends only on these), the layer-0/1 KV
+                // bytes, and the slot geometry. ~300 MB, once per abort.
+                // Disable with IK_NAN_DUMP=0.
+                {
+                    const char * e = getenv("IK_NAN_DUMP");
+                    if (!e || atoi(e) != 0) {
+                        char dir[128];
+                        snprintf(dir, sizeof(dir), "logs/nan-dump-%lld", (long long) ggml_time_us());
+                        if (mkdir(dir, 0755) == 0) {
+                            char path[192];
+                            // token history, int32 little-endian
+                            snprintf(path, sizeof(path), "%s/tokens.bin", dir);
+                            if (FILE * f = fopen(path, "wb")) {
+                                for (size_t i = 0; i < slot.cache_tokens.size(); ++i) {
+                                    int32_t tok = (int32_t) slot.cache_tokens[i];
+                                    fwrite(&tok, sizeof(tok), 1, f);
+                                }
+                                fclose(f);
+                            }
+                            int kv_head = 0, kv_used = 0, kv_n = 0;
+                            llama_ik_kv_info(ctx, &kv_head, &kv_used, &kv_n);
+                            int mb0 = -1, mb1 = -1;
+                            snprintf(path, sizeof(path), "%s/kv_l0.bin", dir);
+                            mb0 = llama_ik_dump_kv_layer(ctx, 0, path);
+                            snprintf(path, sizeof(path), "%s/kv_l1.bin", dir);
+                            mb1 = llama_ik_dump_kv_layer(ctx, 1, path);
+                            snprintf(path, sizeof(path), "%s/meta.txt", dir);
+                            if (FILE * f = fopen(path, "w")) {
+                                fprintf(f, "n_tokens_history %zu\nn_past %d\nn_past_prompt %d\n"
+                                           "kv_head %d\nkv_used %d\nkv_size %d\n"
+                                           "n_ubatch %d\nkv_l0_mb %d\nkv_l1_mb %d\n",
+                                        slot.cache_tokens.size(), slot.n_past, slot.n_past_prompt,
+                                        kv_head, kv_used, kv_n,
+                                        (int) llama_n_ubatch(ctx), mb0, mb1);
+                                fclose(f);
+                            }
+                            LOG_ERROR("NaN dump written -- offline reproducer material", {
+                                {"dir", dir},
+                                {"kv_l0_mb", mb0},
+                                {"kv_l1_mb", mb1},
+                            });
+                        }
+                    }
+                }
+
+                // LOCAL PATCH (ik-llama-toolkit), RESULTS 47.3: walk-back replay.
+                // 47.2's replay of the batch in scope reproduced the NaN
+                // (propagation from the poisoned cache) but captured a healthy
+                // graph -- the batch in scope is the LAST one, not the
+                // poisoning chunk. This version rewinds to the request's
+                // prefill base and re-runs THIS request's chunks exactly as the
+                // server chunked them (bit-exact, unlike the offline replays,
+                // which is what killed those -- 47.1), consulting the in-stream
+                // NaN latch after each chunk. The first chunk that latches is
+                // the origin; it is re-run once more with the fattn-0 capture
+                // armed. Deterministic per 46.4, so it must latch again.
+                if (!getenv("IK_NO_INPLACE_REPLAY")) {
+                    const int32_t rp_base = slot.n_prompt_tokens_cache;
+                    const int32_t rp_end  = (int32_t) slot.cache_tokens.size();
+                    const int32_t rp_ub   = (int32_t) llama_n_ubatch(ctx);
+                    if (rp_base >= 0 && rp_end > rp_base) {
+                        (void) ik_nan_latch_consume();   // clear stale latch
+                        llama_kv_cache_seq_rm(ctx, slot.id, rp_base, -1);
+                        std::vector<llama_token> rp_toks(rp_end - rp_base);
+                        for (int32_t i2 = rp_base; i2 < rp_end; ++i2) rp_toks[i2 - rp_base] = slot.cache_tokens[i2];
+                        int32_t rp_origin = -1, rp_node = -1;
+                        for (int32_t p = 0; p < rp_end - rp_base; p += rp_ub) {
+                            const int32_t n = std::min(rp_ub, rp_end - rp_base - p);
+                            llama_batch rb = llama_batch_get_one(rp_toks.data() + p, n, rp_base + p, slot.id);
+                            if (llama_decode(ctx, rb) != 0) break;
+                            const int latched = ik_nan_latch_consume();
+                            LOG_ERROR("walk-back replay chunk", {
+                                {"p0", rp_base + p}, {"n", n}, {"nan_node", latched},
+                            });
+                            if (latched >= 0) { rp_origin = p; rp_node = latched; break; }
+                        }
+                        if (rp_origin >= 0) {
+                            // origin chunk found: re-run it once more with capture armed
+                            char cap_dir[160];
+                            snprintf(cap_dir, sizeof(cap_dir), "logs/fattn0-capture-%lld", (long long) ggml_time_us());
+                            llama_kv_cache_seq_rm(ctx, slot.id, rp_base + rp_origin, -1);
+                            ik_fattn_capture_arm(cap_dir);
+                            const int32_t n = std::min(rp_ub, rp_end - rp_base - rp_origin);
+                            llama_batch rb = llama_batch_get_one(rp_toks.data() + rp_origin, n, rp_base + rp_origin, slot.id);
+                            const int rc2 = llama_decode(ctx, rb);
+                            const int lat2 = ik_nan_latch_consume();
+                            ik_fattn_capture_disarm();
+                            LOG_ERROR("walk-back replay: ORIGIN chunk re-run", {
+                                {"p0", rp_base + rp_origin}, {"n", n}, {"rc", rc2},
+                                {"first_nan_node", rp_node}, {"relatch_node", lat2},
+                                {"captured", ik_fattn_capture_done()}, {"capture_dir", cap_dir},
+                            });
+                        } else {
+                            LOG_ERROR("walk-back replay: NO chunk re-latched -- origin did not reproduce from the request base", {
+                                {"base", rp_base}, {"end", rp_end},
+                            });
+                        }
+                    }
+                }
+
+                // Same sequence the SLOT_ERASE handler uses below.
+                const size_t n_tok_erased = slot.cache_tokens.size();
+                const size_t n_ckpt_erased = slot.server_cached_prompt.checkpoints.size();
+
+                llama_kv_cache_seq_rm(ctx, slot.id, -1, -1);
+                slot.cache_tokens.keep_first(0);
+                slot.server_cached_prompt.checkpoints.clear();
+                slot.server_cached_prompt.data.clear();
+                slot.n_past = 0;
+                slot.n_past_prompt = 0;
+                slot.n_prompt_tokens_cache = 0;
+                slot.checkpoint_pos = -1;
+                slot.do_checkpoint = false;
+                if (slot.ctx_sampling != nullptr) {
+                    common_sampler_reset(slot.ctx_sampling);
+                }
+
+                // Greppable, because the point of surviving is being able to tell
+                // afterwards that it happened and that recovery was clean:
+                //   grep 'NaN logits' logs/server-*.log
+                // The next request for this slot will show cache_size = 0 and a
+                // prefill from p0=0, which is the confirmation that it recovered.
+                LOG_ERROR("NaN logits -- dropped this slot's cached state, the next request will prefill from scratch", {
+                    {"id_slot",             slot.id},
+                    {"id_task",             slot.id_task},
+                    {"cache_tokens_erased", (uint64_t) n_tok_erased},
+                    {"checkpoints_erased",  (uint64_t) n_ckpt_erased},
+                });
+
                 slot.release();
                 slot.i_batch = -1;
                 continue;
