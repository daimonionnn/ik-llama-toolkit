+// RESULTS 47: dump-on-abort helpers, defined in src/llama.cpp
+struct llama_context;
+extern "C" void llama_ik_kv_info(struct llama_context *, int *, int *, int *);
+extern "C" int  llama_ik_dump_kv_layer(struct llama_context *, int, const char *);
+extern "C" void ik_fattn_capture_arm(const char *);
+extern "C" void ik_fattn_capture_disarm(void);
+extern "C" int  ik_fattn_capture_done(void);
