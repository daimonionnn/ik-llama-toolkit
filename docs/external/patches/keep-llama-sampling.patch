@@ -727,8 +728,38 @@ llama_token llama_sample_token_with_rng_impl(struct llama_sampling * smpl, llama
     auto p = sump * r / rng.max();
     auto iter = std::upper_bound(probs.begin(), probs.end(), p);
     if (iter == probs.end()) {
+        // LOCAL PATCH (ik-llama-toolkit): throw instead of GGML_ABORT.
+        //
+        // Reaching here means every candidate logit is NaN, so upper_bound found
+        // nothing -- all comparisons are false. The logits arrive that way from
+        // llama_decode; nothing in this function produced them.
+        //
+        // llama-server ALREADY handles a throwing sampler: the call site in
+        // examples/server/server-context.cpp wraps common_sampler_sample in
+        // try/catch, logs "sampling failed, releasing slot", returns a 500 for
+        // that one request, releases the slot and carries on. That handler was
+        // unreachable, because GGML_ABORT -> ggml_abort -> abort() is not a C++
+        // exception. So a condition the server knows how to survive was taking
+        // the whole process down, along with every other in-flight request.
+        //
+        // This does not fix, hide or diagnose the NaN -- see RESULTS 32 and
+        // docs/external/issue-nan-logits-abort.md, where the cause is still open.
+        // It only stops one bad token from being fatal to the server.
+        //
+        // The dump gets a unique name too: it used to be a fixed path in the
+        // working directory, so the next occurrence destroyed the previous
+        // evidence. That already cost us the dump from abort #8, and now that
+        // the server survives, repeats are expected rather than exceptional.
+        // Microseconds, not seconds: the counter below only makes names unique
+        // WITHIN a process, so two servers aborting in the same second would
+        // still collide -- which a test caught before this shipped.
+        static int n_failed = 0;
+        char fname[64];
+        snprintf(fname, sizeof(fname), "probabilities-%lld-%d.txt",
+                 (long long) ggml_time_us(), ++n_failed);
+
         LLAMA_LOG_ERROR("=============================== Failed to sample token\n");
-        std::ofstream out("probabilities.txt");
+        std::ofstream out(fname);
         out << "candidates->size: " << candidates->size << std::endl;
         out << "max  = " << max << std::endl;
         out << "sump = " << sump << std::endl;
@@ -739,10 +770,11 @@ llama_token llama_sample_token_with_rng_impl(struct llama_sampling * smpl, llama
         }
         out.flush();
         out.close();
-        LLAMA_LOG_ERROR("Data has been stored in probabilities.txt\n");
-        LLAMA_LOG_ERROR("Create an issue with full log and attach probabilities.txt to the issue\n");
-        LLAMA_LOG_ERROR("\n\nCrashing now\n");
-        GGML_ABORT("Fatal error");
+        LLAMA_LOG_ERROR("Data has been stored in %s\n", fname);
+        LLAMA_LOG_ERROR("Create an issue with full log and attach that file to the issue\n");
+
+        throw std::runtime_error(
+            std::string("failed to sample token: all candidate logits are NaN (dump: ") + fname + ")");
     }
     GGML_ASSERT(iter != probs.end());
