+// LOCAL FIX (ik-llama-toolkit), RESULTS 49.9. The CSA mask is one host-side
+// input tensor, but dsv4_build_raw_mask_view is called twice per CSA layer
+// (indexer + top-k mask) and returned a fresh view of it every time.
+// ggml_backend_sched keys its split-input copies by tensor, so every view
+// became its own n_kv x n_tokens device copy, and all input copies of a split
+// are allocated at the START of that split. With N contiguous GPU-resident
+// expert layers -- one big split -- that is 2 x N x 256 MiB at 128k / -ub 4096
+// (512 MiB at -ub 8192): the whole "compute buffer grows with -ncmoe" curve,
+// and 2 x N host-to-device transfers of the same bytes per u-batch. When the
+// caller asks for the whole mask, hand back the mask itself: one tensor, one
+// copy per split, shared by every layer. IK_MASK_SHARE=0 restores the old
+// behaviour so the two can be measured against each other with one binary.
+static bool dsv4_share_full_mask() {
+    static const bool share = [] {
+        const char * env = getenv("IK_MASK_SHARE");
+        return env == nullptr || atoi(env) != 0;
+    }();
+    return share;
+}
+
+// LOCAL FIX (ik-llama-toolkit), RESULTS 49.11. The SWA window cut below is a
+// strided view of the host-side mask input. Left to the scheduler, its
+// ggml_cont lands on the GPU, so the VIEW becomes the split input and is
+// copied by its span -- first-to-last byte, i.e. the whole n_kv x n_tokens
+// mask, 2 GiB at 131072 / -ub 8192, 8 GiB at 524288 -- once per graph,
+// through the blocking host-to-device path, and allocated in the CUDA compute
+// buffer for the duration of the cont. Cut on the CPU instead, the window is
+// one contiguous nton x n_tokens tensor (132 MiB at -ub 8192) and that is all
+// that crosses the bus. The cut only gets its "_cpu" name here;
+// llama_build_graph's callback does the pinning, the way it pins
+// kqv_merged_cont for -nkvo.
+//
+// Measured (49.11): at 131072 the span never sets the buffer's peak, so the
+// CPU cut is worth 248 MiB of VRAM and no throughput; at 524288 it is the
+// peak and the cut saves 3.8 GiB. Per token it costs an extra CPU split and
+// its sync (-1 % generation), so it is only applied to u-batches of at least
+// IK_MASK_WINDOW_CPU tokens (default 256): every prefill u-batch, and the
+// worst-case graph the compute buffer is reserved from. 0 disables it.
+static int dsv4_window_cpu_min_tokens() {
+    static const int min_tokens = [] {
+        const char * env = getenv("IK_MASK_WINDOW_CPU");
+        return env == nullptr ? 256 : atoi(env);
+    }();
+    return min_tokens;
+}
