diff --git a/examples/server/server-context.cpp b/examples/server/server-context.cpp
index d16efa06..03c1614b 100644
--- a/examples/server/server-context.cpp
+++ b/examples/server/server-context.cpp
@@ -4812,6 +4812,42 @@ void server_context::process_batch_tokens(int32_t & n_batch) {
                     {"error", e.what()},
                 });
                 send_error(slot, std::string("sampling error: ") + e.what(), ERROR_TYPE_SERVER);
+
+                // LOCAL PATCH (ik-llama-toolkit), RESULTS 33. Drop this slot's
+                // cached state. release() alone keeps cache_tokens, the KV cells
+                // and the checkpoints, so the state that just produced NaN
+                // logits would be REUSED by the next request carrying the same
+                // prefix -- and a retry is exactly what an agent client does
+                // with a 500. Either it aborts again and the agent spins, or it
+                // does not and the answer is silently degraded; the second is
+                // worse, because nothing reports it.
+                //
+                // Kept after the 49.2 root-cause fix as a belt-and-braces
+                // measure: the abort should no longer occur (3.4 M tokens clean
+                // against 13.8 expected), but if anything ever produces NaN
+                // logits again, refusing to build on that state is still right.
+                // Greppable: grep 'NaN logits' logs/server-*.log
+                const size_t n_tok_erased  = slot.cache_tokens.size();
+                const size_t n_ckpt_erased = slot.server_cached_prompt.checkpoints.size();
+                llama_kv_cache_seq_rm(ctx, slot.id, -1, -1);
+                slot.cache_tokens.keep_first(0);
+                slot.server_cached_prompt.checkpoints.clear();
+                slot.server_cached_prompt.data.clear();
+                slot.n_past = 0;
+                slot.n_past_prompt = 0;
+                slot.n_prompt_tokens_cache = 0;
+                slot.checkpoint_pos = -1;
+                slot.do_checkpoint = false;
+                if (slot.ctx_sampling != nullptr) {
+                    common_sampler_reset(slot.ctx_sampling);
+                }
+                LOG_ERROR("NaN logits -- dropped this slot's cached state, the next request will prefill from scratch", {
+                    {"id_slot",             slot.id},
+                    {"id_task",             slot.id_task},
+                    {"cache_tokens_erased", (uint64_t) n_tok_erased},
+                    {"checkpoints_erased",  (uint64_t) n_ckpt_erased},
+                });
+
                 slot.release();
                 slot.i_batch = -1;
                 continue;
