# =============================================================================
# DeepSeek-V4-Flash -- Unsloth Dynamic Q8_K_XL  (~151 GiB)
# =============================================================================
# Architecture (from GGUF): deepseek4 -- 43 layers, 256 experts (6 + 1 shared),
# expert FFN 2048. This is a DeepSeek MLA model with DeepSeek Sparse Attention:
#   attention   MLA -- head_count 64, KV heads 1, q/kv lora 1024, latent 512
#   DSA         indexer top_k 512, sliding window 128
#   context     1 048 576 trained
#
# THIS is the architecture ik_llama.cpp is built for. MLA compresses the KV
# cache to a tiny latent (unlike a plain GQA model), and FlashMLA + the fused
# DSA indexer (-fidx) are more mature here than mainline llama.cpp. So unlike
# Step-3.7-Flash (where standard llama.cpp won), DeepSeek is expected to favour
# ik_llama -- but measure it (docs/RESULTS.md) rather than assume.
#
#   ./serve.sh deepseek-v4-flash
# -----------------------------------------------------------------------------

# DeepSeek-V4-Flash 0731, MXFP4 (~146 GiB). QAT with native MXFP4 experts, so
# this quant is effectively lossless -- and being 4-bit it generates faster than
# the old Q8 (~22 vs ~17 tok/s at 65536, fewer bytes to read from DDR5 per token).
# (The earlier unsloth Q8_K_XL was deleted to free disk; swap the path back if
# you restore it.)
: "${IK_MODEL_GLOB:=/home/matt/.lmstudio/models/lmstudio-community/DeepSeek-V4-Flash-0731-GGUF/DeepSeek-V4-Flash-0731-MXFP4-00001-of-*.gguf}"

: "${IK_ALIAS:=deepseek-v4-flash}"

# Full context. MLA keeps the KV cache modest (~11 GiB at 262144 vs 24 GiB for
# the step35 model), which is what makes 262144 feasible here at all.
: "${IK_CTX:=262144}"

# --fit fills VRAM automatically. MEASURED: at 262144 the default 2048 MiB margin
# OOMs -- --fit accounts for the MLA KV cache but NOT the DeepSeek Sparse
# Attention caches (~1.7 GiB, allocated after the fit decision) nor the large
# compute buffer. So two adjustments make 262144 fit (verified: 91.7 GiB used,
# ~13 tok/s):
#   * a bigger margin, to cover the DSA caches + compute buffer, and
#   * a smaller ubatch (below), which halves the compute buffer.
# At 65536 the defaults (margin 2048, ub 1024) are fine and fill VRAM to 93.7 GiB
# at ~17 tok/s -- lower IK_CTX if you want that extra speed over max context.
: "${IK_FIT:=1}"
: "${IK_FIT_MARGIN:=8192}"

# Smaller micro-batch -> ~half the CUDA compute buffer, which is what lets the
# big 262144 KV + DSA caches fit. Costs some prefill speed (irrelevant for chat).
: "${IK_UBATCH:=512}"

# MLA cache is already a compressed latent -- do NOT quantize it to q8_0 (the
# toolkit's default). f16 is the right choice for an MLA model.
: "${IK_CTK:=f16}"
: "${IK_CTV:=f16}"

# DeepSeek-V4 specifics: MLA mode 3 (ik_llama default, explicit for clarity),
# the fused DSA indexer top-k op (faster for this sparse-attention model), and
# DeepSeek reasoning routed to message.reasoning_content.
: "${IK_EXTRA_ARGS:=-mla 3 -fidx --reasoning-format deepseek}"
