# =============================================================================
# Qwen3.8-Flash-Next Q4_K_M -- alias for the 128k profile
# =============================================================================
# The unsuffixed name is kept so `./serve.sh qwen38-flash-next-q4km` works and
# lands on the sensible default. Both real profiles are:
#
#   qwen38-flash-next-q4km-128k    -ub 2048, 3486 pp / 128.9 tg   <-- this one
#   qwen38-flash-next-q4km-256k    -ub 1024, 3342 pp / 128.6 tg
#
# 128k is the default because it is the faster of the two at prefill and the
# generation figures are identical; take the 256k profile when the window is
# actually needed.
# -----------------------------------------------------------------------------

source "$(dirname "${BASH_SOURCE[0]}")/qwen38-flash-next-q4km-128k.env"
