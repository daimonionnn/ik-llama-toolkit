# =============================================================================
# Step-3.7-Flash -- Unsloth Dynamic Q4_K_XL   (default profile)
# =============================================================================
# Architecture (read from the GGUF metadata):
#   arch                step35            block_count          45
#   experts             288               experts used         8
#   expert FFN dim      1280              shared expert FFN    1280
#   leading dense       3 layers          dense FFN dim        11264
#   n_embd              4096              KV heads             8 x 128
#   sliding window      512 (NOT used to shrink the KV cache in this build)
#   trained context     262144            rope base            5e6 (SWA 1e4)
#
# ~7.4 B active parameters out of ~220 B total: generation is fast as long as
# the 8 active experts per layer live in fast memory. ~91% of all weights are
# routed experts, so expert placement dominates everything else.
#
# On disk: ~114 GiB across 4 shards. That is ~18 GiB more than the 96 GiB of
# VRAM, so roughly 10-12 layers' worth of experts end up in system RAM.
# -----------------------------------------------------------------------------

# Only the first shard is named; llama.cpp finds 00002..00004 alongside it.
: "${IK_MODEL_GLOB:=/home/matt/.lmstudio/models/unsloth/Step-3.7-Flash-GGUF/Step-3.7-Flash-UD-Q4_K_XL-00001-of-*.gguf}"

: "${IK_ALIAS:=step-3.7-flash}"

# --- context + expert split (MEASURED on this box, 2026-07-25) ----------------
# Full trained context. The KV cache for this build is a full-length cache on
# ALL 45 layers (the sliding-window layers are NOT given a reduced buffer -- see
# docs/TUNING.md §3), so it is large and scales linearly:
#   32768 -> 3 GiB   65536 -> 6 GiB   131072 -> 12 GiB   262144 -> 24 GiB (q8_0)
# At 262144 that 24 GiB cache is ~9 expert layers of VRAM, so more experts move
# to the CPU and generation slows. This is the deliberate trade for max context.
: "${IK_CTX:=262144}"

# Hand-picked expert split, not --fit. --fit is measured ~5 tok/s slower here
# because it reserves more headroom. ncmoe=22 is the fastest split that loads at
# 262144 with q8_0 KV and still leaves ~4 GiB of VRAM free (ncmoe=21 also loads,
# ~1 tok/s faster, but only ~2 GiB free). Verified by starting the real server.
#   262144 q8_0 : ncmoe 22 -> ~25 tok/s (default) | 21 -> ~26 tok/s (tighter)
#   262144 q4_0 : ncmoe 18 -> ~30 tok/s  (set IK_CTK=IK_CTV=q4_0, see below)
#   131072 q8_0 : ncmoe ~17 -> ~32 tok/s
#    65536 q8_0 : ncmoe 14 -> ~38 tok/s
# If you lower IK_CTX, also lower IK_NCMOE (fewer experts need to leave the GPU).
: "${IK_NCMOE:=22}"

# q8_0 KV is the quality-safe default. For ~20% more speed at 262144 at a small
# KV-quality cost, switch to q4_0 (frees ~11 GiB -> more experts on GPU) and
# drop IK_NCMOE to 18:  IK_CTK=q4_0 IK_CTV=q4_0 IK_NCMOE=18 ./serve.sh
# : "${IK_CTK:=q4_0}"
# : "${IK_CTV:=q4_0}"

# Multimodal projector shipped with this repo. Uncomment to enable image input;
# it costs ~8 GiB of VRAM -- at 262144 context you must lower IK_CTX or raise
# IK_NCMOE to make room, or it will OOM.
# : "${IK_MMPROJ:=/home/matt/.lmstudio/models/unsloth/Step-3.7-Flash-GGUF/mmproj-F32.gguf}"
