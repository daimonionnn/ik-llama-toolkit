# DeepSeek-V4-Flash-0731 MXFP4 (~146 GiB) -- the profile every number in
# docs/RESULTS.md §5 was measured on, and the case this toolkit wins.
#
# MXFP4 is the QAT model's native expert format, so this is a repack rather
# than a re-quantisation: no quality is lost relative to the released weights.
# --fit lands on ~16 CPU expert layers at 131072 context.
#
# The q8_0 KV cache (inherited from default.env) is the point of the profile:
# it halves cache size versus f16 at no measurable quality cost, and mainline
# llama.cpp segfaults trying to do the same on this model past ~4k context.
: "${IK_MODEL_GLOB:=/home/matt/.lmstudio/models/lmstudio-community/DeepSeek-V4-Flash-0731-GGUF/DeepSeek-V4-Flash-0731-MXFP4-00001-of-*.gguf}"
: "${IK_ALIAS:=deepseek-mxfp4-ik}"
: "${IK_CTX:=131072}"
: "${IK_FIT:=1}"
: "${IK_FIT_MARGIN:=8192}"
: "${IK_EXTRA_ARGS:=-mla 3 -fidx --reasoning-format deepseek}"
