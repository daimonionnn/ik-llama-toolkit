# =============================================================================
# Qwen3.8-Flash-Next Q4_K_M at 262144 -- the model's full advertised context
# =============================================================================
# Same model, same placement, one flag different from the 128k profile: -ub is
# 1024 rather than 2048. See qwen38-flash-next-q4km-128k.env for the
# architecture notes and the expert-placement sweep that produced -ncmoe 0.
#
# 262144 is what the GGUF advertises (qwen4exp.context_length), and unlike the
# DeepSeek profiles it costs almost nothing in KV: the hybrid keeps a cache on
# only every 4th layer, so doubling the context adds 2112 MiB, not 12 GiB.
#
#   -c        KV (q8_0)   compute buffer @ub1024   CUDA0 weights   total
#   131072      2 224            4 522                 79 710      86 457
#   262144      4 337            8 938                 79 710      92 984
#
# THE COMPUTE BUFFER IS WHAT SETS -ub, and it scales with -ub TIMES n_kv:
# 9044 MiB at (ub 2048, 128k) and 8938 at (ub 1024, 256k) are the same product.
# At 262144 that leaves -ub 1024 as the only setting that fits -- 2048 would
# want ~17.9 GiB of compute buffer and overflow the card by ~5.5 GiB.
#
# --- MEASURED 2026-09-03, sweep-bench ----------------------------------------
#
#   -c 262144, -ncmoe 0, -ub 1024:   3341.7 pp / 128.6 tg   at N_KV 1024
#                                    1346.5 pp /  59.7 tg   at N_KV 103424
#
# Generation is identical to the 128k profile (128.6 against 128.9) because the
# weight placement is identical; the only real cost of 256k is the 2.1 GiB of
# extra KV and the smaller micro-batch, which shows up as ~4 % less prefill at
# shallow depth. Cheap, for twice the window.
#
#   ./serve.sh qwen38-flash-next-q4km-256k
# -----------------------------------------------------------------------------

: "${IK_MODEL_GLOB:=${IK_MODELS_ROOT}/lmstudio-community/Qwen3.8-Flash-Next-GGUF/Qwen3.8-Flash-Next-Q4_K_M-00001-of-*.gguf}"

: "${IK_ALIAS:=qwen38-flash-next-q4km-256k}"
: "${IK_CTX:=262144}"

: "${IK_RTR:=0}"

: "${IK_FIT:=0}"
: "${IK_NCMOE:=0}"

# 1024, not 2048: the compute buffer scales with -ub * n_kv and 2048 does not
# fit at this context. Generation does not care; prefill loses ~4 %.
: "${IK_UBATCH:=1024}"
: "${IK_BATCH:=1024}"

: "${IK_CTK:=q8_0}"
: "${IK_CTV:=q8_0}"

: "${IK_THREADS:=8}"
: "${IK_THREADS_BATCH:=24}"
